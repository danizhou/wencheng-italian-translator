{
  "_doc": "IPA → Italian spelling rules, used by src/lib/ita.ts. Every change needs a test in tests/ita.test.ts. Initials and finals are matched longest first. 'soft': soft c/g, an i is inserted before non-front vowels (a, o, u, ü). 'beforeFront': spelling before e/è/i (e.g. c → ch).",
  "ignoredPrefixes": [
    { "ipa": "ʔ", "_note": "glottal stop: ʔȵi → gni, ʔŋ̍ → ng, ʔia → ia" }
  ],
  "initials": [
    { "ipa": "ɦŋ̍", "ita": "ng", "_note": "syllabic nasal" },
    { "ipa": "ŋ̍", "ita": "ng" },
    { "ipa": "n̩", "ita": "n", "_note": "syllabic n (Qingtian)" },
    { "ipa": "m̩", "ita": "m", "_note": "syllabic m (Qingtian)" },
    { "ipa": "tɕʰ", "ita": "c", "soft": true },
    { "ipa": "tɕ", "ita": "c", "soft": true },
    { "ipa": "dʑ", "ita": "g", "soft": true },
    { "ipa": "ʑ", "ita": "sg", "soft": true },
    { "ipa": "ɕ", "ita": "sc", "soft": true },
    { "ipa": "tsʰ", "ita": "z" },
    { "ipa": "ts", "ita": "z" },
    { "ipa": "dz", "ita": "z" },
    { "ipa": "pʰ", "ita": "p", "_note": "aspiration ignored" },
    { "ipa": "tʰ", "ita": "t" },
    { "ipa": "kʰ", "ita": "c", "beforeFront": "ch" },
    { "ipa": "k", "ita": "c", "beforeFront": "ch" },
    { "ipa": "ɡ", "ita": "g", "beforeFront": "gh" },
    { "ipa": "ȵ", "ita": "gn" },
    { "ipa": "ŋ", "ita": "ng" },
    { "ipa": "ɦ", "ita": "", "_note": "silent h: set to \"h\" to write it" },
    { "ipa": "ɓ", "ita": "b", "_note": "implosive b (Qingtian)" },
    { "ipa": "ɗ", "ita": "d", "_note": "implosive d (Qingtian)" },
    { "ipa": "x", "ita": "h", "_note": "velar fricative, as in pinyin (Qingtian)" },
    { "ipa": "j", "ita": "i" },
    { "ipa": "ɿ", "ita": "i", "_note": "ɿ with no consonant before it: ʔɿ → i, not silent (Qingtian)" }
  ],
  "finals": [
    { "ipa": "yu", "ita": "iu" },
    { "ipa": "ɔ", "ita": "o" },
    { "ipa": "ɑ", "ita": "a" },
    { "ipa": "ɛ", "ita": "è" },
    { "ipa": "ə", "ita": "e" },
    { "ipa": "ɜ", "ita": "e", "_note": "Wenzhou only" },
    { "ipa": "ɤ", "ita": "e" },
    { "ipa": "ø", "ita": "eu" },
    { "ipa": "y", "ita": "ü" },
    { "ipa": "ŋ", "ita": "ng" },
    { "ipa": "ɿ", "ita": "", "_note": "zɿ → z" },
    { "ipa": "ʮ", "ita": "u", "_note": "rounded ɿ: tsʮ → zu (Qingtian)" },
    { "ipa": "ʌʉ", "ita": "eu", "_note": "same spelling as the related ɤu (Qingtian)" },
    { "ipa": "ɤʉ", "ita": "eu", "_note": "Qingtian" },
    { "ipa": "ʉ", "ita": "ü", "_note": "Qingtian" },
    { "ipa": "æ", "ita": "è", "_note": "Qingtian" },
    { "ipa": "œ", "ita": "eu", "_note": "like ø (Qingtian)" },
    { "ipa": "ɐ", "ita": "a", "_note": "Qingtian" },
    { "ipa": "ʌ", "ita": "a", "_note": "Qingtian" },
    { "ipa": "ɪ", "ita": "i", "_note": "Qingtian" },
    { "ipa": "ʔ", "ita": "", "_note": "final glottal stop of tones 7/8: not written (Qingtian)" }
  ],
  "frontVowels": ["e", "è", "i"],
  "cleanup": [
    { "from": "ii", "to": "i", "_note": "ʔjiai → iai" }
  ]
}
